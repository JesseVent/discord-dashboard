{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dashboard-sync-cron",
  "main": "src/index.js",
  "compatibility_date": "2024-04-01",
  "triggers": {
    "crons": ["0 * * * *"] // Runs at minute 0 of every hour
  },
  "vars": {
    "TARGET_URL": "https://your-vercel-domain.com/api/cron/sync"
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "discord-backups"
    }
  ]
}
