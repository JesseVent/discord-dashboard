// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Legacy demo models (kept for compatibility, unused by issue tracker)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// DISCORD ISSUE TRACKER MODELS
// ============================================================

/// A Discord forum thread treated as a support issue.
model Issue {
  id                     String   @id // Discord thread ID (snowflake)
  name                   String
  channelId              String
  guildId                String?
  ownerId                String
  ownerUsername          String
  ownerGlobalName        String?
  ownerAvatar            String?

  createdAt              DateTime // thread creation time
  archivedAt             DateTime?
  archived               Boolean  @default(false)
  locked                 Boolean  @default(false)

  messageCount           Int      @default(0)
  memberCount            Int      @default(0)
  totalMessageSent       Int      @default(0)

  appliedTags            String   @default("[]") // JSON array of tag IDs

  firstMessageId         String?
  firstMessageContent    String   @default("")
  firstMessageAuthorId   String?
  firstMessageAuthorName String?
  firstMessageCreatedAt  DateTime?

  // Response analytics (populated when replies are fetched)
  responseTimeMs         BigInt?
  responderCount         Int      @default(0)
  isAnswered             Boolean  @default(false)
  resolutionStatus       String   @default("unknown") // unanswered | in-progress | likely-resolved | unknown

  // Sentiment (populated by LLM sentiment analysis)
  sentiment              String?  // frustrated | neutral | positive | resolved | unknown
  sentimentScore         Float?   // -1.0 to 1.0
  sentimentSummary       String?

  // Duplicate detection (populated by LLM duplicate clustering)
  duplicateClusterId     String?
  duplicateCluster       DuplicateCluster? @relation(fields: [duplicateClusterId], references: [id])

  replies                Reply[]
  fetchedAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([channelId])
  @@index([ownerId])
  @@index([createdAt])
  @@index([resolutionStatus])
  @@index([sentiment])
  @@index([duplicateClusterId])
}

/// A single reply message within an issue thread.
model Reply {
  id              String   @id // Discord message ID
  issueId         String
  issue           Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  authorId        String
  authorUsername  String
  authorGlobalName String?
  content         String   @default("")
  timestamp       DateTime
  hasAttachment   Boolean  @default(false)
  attachmentCount Int      @default(0)

  // Sentiment of this specific reply
  sentiment       String?  // frustrated | neutral | positive | resolved | unknown
  sentimentScore  Float?

  createdAt       DateTime @default(now())

  @@index([issueId])
  @@index([authorId])
  @@index([timestamp])
}

/// A cluster of semantically similar (duplicate) issues.
model DuplicateCluster {
  id          String   @id @default(cuid())
  name        String   // short label for the cluster theme
  description String?
  issueCount  Int      @default(0)
  issues      Issue[]
  createdAt   DateTime @default(now())
}

/// LLM-generated theme clusters (persisted so re-analysis is optional).
model ThemeCluster {
  id            String   @id @default(cuid())
  theme         String
  description   String   @default("")
  keywords      String   @default("[]") // JSON array
  count         Int      @default(0)
  sampleIssueIds String  @default("[]") // JSON array
  method        String   @default("llm") // llm | fallback
  channelId     String?
  createdAt     DateTime @default(now())

  @@index([channelId])
  @@index([method])
}
